# ==========================================
# SMS Finance Service - Root .gitignore
# ==========================================

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/
*.out

# ==========================================
# Backend (Spring Boot & Maven)
# ==========================================
backend/target/
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Embedded Databases & Local Storage
*.h2.db
*.mv.db
*.trace.db
backend/uploads/collateral/*
!backend/uploads/collateral/.gitkeep
backend/data/

# ==========================================
# Frontend (React + Vite)
# ==========================================
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
**/dist/
*.local
.env.local
.env.*.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Frontend Build & Cache
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/
